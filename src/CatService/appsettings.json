{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "CatActivity": {
    "Durations": {
      "Eating": {
        "MinMinutes": 5,
        "MaxMinutes": 10
      },
      "Playing": {
        "MinMinutes": 5,
        "MaxMinutes": 15
      },
      "Resting": {
        "MinMinutes": 10,
        "MaxMinutes": 120
      },
      "Idle": {
        "MinMinutes": 5,
        "MaxMinutes": 30
      }
    }
  }
}