<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CatService</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="Protos\cat.proto" 
              GrpcServices="Server" 
              AdditionalProtocArguments="--proto_path=$(CommonProtoRoot)" />
    <Protobuf Include="$(CommonProtoRoot)\common\pagination.proto"
              GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.64.0" />
    <ProjectReference Include="..\Shared\Pagination\Pagination.csproj" />
  </ItemGroup>

</Project>
